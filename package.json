{
  "name": "lila-player",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "ph33nx",
    "url": "https://github.com/ph33nx/lila-player"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3123",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "deps:check": "ncu",
    "deps:upgrade": "ncu -u --target minor && npm install",
    "deps:latest": "ncu -u --target latest && npm install",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "15.5.21",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "npm-check-updates": "^23",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.3"
  }
}
